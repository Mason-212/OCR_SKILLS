#!/bin/zsh
# Watch Obsidian OCR Inbox folder(s); OCR new images into sibling .md files.
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
OCR="$SCRIPT_DIR/ocr-to-md"
SLEEP_IDLE="${OCR_SLEEP_IDLE:-8}"
SLEEP_BUSY="${OCR_SLEEP_BUSY:-2}"
SLEEP_FAIL="${OCR_SLEEP_FAIL:-20}"
DISCOVER_EVERY=60
SKIP_FILE="${OCR_SKIP_FILE:-$HOME/Library/Application Support/ocr-to-md/skipped-images}"
DEFER_FILE="${OCR_DEFER_FILE:-$HOME/Library/Application Support/ocr-to-md/deferred-images}"
renice 10 $$ >/dev/null 2>&1 || true

if [[ -t 1 ]]; then
  C_MAGENTA=$'\033[35m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_MAGENTA=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

usage() {
  cat <<'EOF'
Usage: watch-inbox [--force] [--discover ROOT] [folder ...]

Polls each folder for new images and runs ocr-to-md.
--discover ROOT  re-scan ROOT for directories named "OCR Inbox"
Skips images that already have a sibling .md unless --force is passed.
EOF
}

FORCE_FLAG=()
DISCOVER_ROOT=""
FOLDERS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE_FLAG=(--force); shift ;;
    --discover)
      DISCOVER_ROOT="${2:-}"
      if [[ -z "$DISCOVER_ROOT" ]]; then
        echo "--discover needs a folder" >&2
        exit 2
      fi
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) FOLDERS+=("$1"); shift ;;
  esac
done

if [[ -z "$DISCOVER_ROOT" && ${#FOLDERS[@]} -eq 0 ]]; then
  usage
  exit 2
fi

if [[ -n "$DISCOVER_ROOT" ]]; then
  DISCOVER_ROOT="${DISCOVER_ROOT:A}"
fi

typeset -A SEEN
typeset -A FOLDER_MTIME
typeset -A FAIL_COUNT
WATCHING=()
LAST_DISCOVER=0
HAD_WORK=0
HAD_FAIL=0

processed_key() {
  local f="$1"
  stat -f '%N %m %z' "$f"
}

is_skipped() {
  local img="$1" base
  [[ -f "$SKIP_FILE" ]] || return 1
  base="${img:t}"
  grep -Fxq -- "$base" "$SKIP_FILE" || grep -Fxq -- "${img:A}" "$SKIP_FILE"
}

is_deferred() {
  local img="$1" base
  [[ -f "$DEFER_FILE" ]] || return 1
  base="${img:t}"
  grep -Fxq -- "$base" "$DEFER_FILE" || grep -Fxq -- "${img:A}" "$DEFER_FILE"
}

clear_deferred() {
  local img="$1" abs base tmp
  [[ -f "$DEFER_FILE" ]] || return 0
  abs="${img:A}"
  base="${img:t}"
  tmp="$(mktemp "${TMPDIR:-/tmp}/ocr-defer.XXXXXX")"
  grep -Fxv -- "$abs" "$DEFER_FILE" | grep -Fxv -- "$base" > "$tmp" || true
  if [[ -s "$tmp" ]]; then
    mv "$tmp" "$DEFER_FILE"
  else
    rm -f "$DEFER_FILE" "$tmp"
  fi
}

# True when some other inbox image is waiting and has not been sent to the back.
has_ready_pending() {
  local folder img md key
  for folder in "${WATCHING[@]}"; do
    for img in "$folder"/*(.N) "$folder"/*/*(.N); do
      [[ -e "$img" ]] || continue
      case "${img:l}" in
        *.png|*.jpg|*.jpeg|*.webp|*.heic|*.heif|*.tif|*.tiff|*.gif|*.bmp) ;;
        *) continue ;;
      esac
      is_skipped "$img" && continue
      is_deferred "$img" && continue
      md="${img:r}.md"
      if [[ ${#FORCE_FLAG} -eq 0 && -f "$md" ]]; then
        continue
      fi
      key="$(processed_key "$img")"
      if [[ -n "${SEEN[$key]:-}" ]]; then
        continue
      fi
      return 0
    done
  done
  return 1
}

refresh_folders() {
  local now=$SECONDS
  if [[ -n "$DISCOVER_ROOT" && ${#WATCHING[@]} -gt 0 && $((now - LAST_DISCOVER)) -lt $DISCOVER_EVERY ]]; then
    return
  fi
  local -a discovered=()
  local d
  if [[ -n "$DISCOVER_ROOT" && -d "$DISCOVER_ROOT" ]]; then
    while IFS= read -r -d '' d; do
      discovered+=("$d")
    done < <(find "$DISCOVER_ROOT" -type d -name 'OCR Inbox' -print0 2>/dev/null)
  fi
  local -a combined=("${FOLDERS[@]}" "${discovered[@]}")
  WATCHING=()
  for d in "${combined[@]}"; do
    [[ -d "$d" ]] || mkdir -p "$d"
    WATCHING+=("${d:A}")
  done
  LAST_DISCOVER=$now
}

scan_folder() {
  local folder="$1"
  local img md key mt pending=0
  mt="$(stat -f %m "$folder" 2>/dev/null || echo 0)"
  # Defer-file changes do not bump folder mtime, so keep scanning while anything is at the back.
  if [[ ! -s "$DEFER_FILE" && ${#FORCE_FLAG} -eq 0 && "${FOLDER_MTIME[$folder]:-}" == "$mt" ]]; then
    return
  fi
  for img in "$folder"/*(.N) "$folder"/*/*(.N); do
    [[ -e "$img" ]] || continue
    case "${img:l}" in
      *.png|*.jpg|*.jpeg|*.webp|*.heic|*.heif|*.tif|*.tiff|*.gif|*.bmp) ;;
      *) continue ;;
    esac
    if is_skipped "$img"; then
      continue
    fi
    md="${img:r}.md"
    if [[ ${#FORCE_FLAG} -eq 0 && -f "$md" ]]; then
      continue
    fi
    key="$(processed_key "$img")"
    if [[ -n "${SEEN[$key]:-}" ]]; then
      continue
    fi
    if is_deferred "$img" && has_ready_pending; then
      continue
    fi
    printf '\n%s◆%s OCR  %s%s%s\n' "$C_MAGENTA" "$C_RESET" "$C_BOLD" "$img" "$C_RESET"
    HAD_WORK=1
    if "$OCR" "${FORCE_FLAG[@]}" "$img"; then
      SEEN[$key]=1
      clear_deferred "$img"
      printf '%s✓%s done\n' "$C_GREEN" "$C_RESET"
    else
      printf '%s✗%s failed: %s\n' "$C_YELLOW" "$C_RESET" "$img" >&2
      HAD_FAIL=1
      pending=1
      if is_deferred "$img"; then
        # /ocr-terminate killed this page and sent it to the back — not a strike.
        :
      else
        FAIL_COUNT[$img]=$(( ${FAIL_COUNT[$img]:-0} + 1 ))
        if [[ ${FAIL_COUNT[$img]} -ge 8 ]]; then
          SEEN[$key]=1
          printf '%s✗%s giving up after 8 tries: %s\n' "$C_YELLOW" "$C_RESET" "$img" >&2
        fi
      fi
    fi
  done
  if [[ $pending -eq 0 ]]; then
    FOLDER_MTIME[$folder]="$mt"
  else
    unset "FOLDER_MTIME[$folder]"
  fi
}

refresh_folders
printf '%s╭──────────────────────────────────────╮%s\n' "$C_MAGENTA" "$C_RESET"
printf '%s│%s  ocr-to-md watcher  ·  local only    %s│%s\n' "$C_MAGENTA" "$C_RESET" "$C_MAGENTA" "$C_RESET"
printf '%s╰──────────────────────────────────────╯%s\n' "$C_MAGENTA" "$C_RESET"

if [[ ${#WATCHING[@]} -eq 0 ]]; then
  printf '%s│%s No OCR Inbox folders yet. Waiting under %s\n' "$C_YELLOW" "$C_RESET" "${DISCOVER_ROOT:-<none>}"
else
  printf '%s│%s Watching %s%s%s inbox(es)\n' "$C_CYAN" "$C_RESET" "$C_BOLD" "${#WATCHING[@]}" "$C_RESET"
  for d in "${WATCHING[@]}"; do
    printf '  %s·%s %s\n' "$C_DIM" "$C_RESET" "$d"
  done
fi

while true; do
  HAD_WORK=0
  HAD_FAIL=0
  refresh_folders
  for f in "${WATCHING[@]}"; do
    scan_folder "$f"
  done
  if [[ $HAD_FAIL -eq 1 ]]; then
    sleep "$SLEEP_FAIL"
  elif [[ $HAD_WORK -eq 1 ]]; then
    sleep "$SLEEP_BUSY"
  else
    sleep "$SLEEP_IDLE"
  fi
done
